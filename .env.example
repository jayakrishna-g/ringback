# Copy to .env and fill in. scripts/deploy.py reads it; .env is git-ignored and never uploaded.

# Both keys become Runta secrets, injected on the wire. The runtime only ever sees a placeholder.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Twilio account, and the Twilio number people call (E.164).
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_NUMBER=+15550001111

# Your own phone. Only these numbers may call in or get called (comma-separated).
RINGBACK_OWNER_NUMBERS=+15552223333

# Optional
# RINGBACK_IDLE_SECS=0           0 = always on (default); >0 = suspend when idle (calls can't wake it yet)
# RINGBACK_CALL_WHEN_DONE=1      phone the owner when a task finishes (failures always call)
# RINGBACK_REALTIME_MODEL=gpt-realtime
